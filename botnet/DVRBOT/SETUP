sudo tar -C /usr/local -xzf go1.14.2.linux-amd64.tar.gz 
export PATH=$PATH:/usr/local/go/bin 
source ~/.bash_profile 
rm -rf go1.14.2.linux-amd64.tar.gz
cd ~/

 
